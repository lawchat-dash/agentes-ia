# App "painel" (Easypanel): front compilado (painel/dist) e API de gestão /api/*. Sem laços de fundo.
# Build:  docker build -f Dockerfile.painel -t lawchat-painel .

# ---- 1) build do front (React/Vite)
FROM node:20-slim AS front
WORKDIR /painel
COPY painel/package.json painel/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY painel/ ./
RUN npm run build

# ---- 2) servidor Python
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000 \
    AGENTESIA_PASTA_MIDIA=/dados/midia

WORKDIR /srv

# ffmpeg: converte vídeo gravado no navegador (WebM) ou do iPhone (MOV) para MP4, e áudio WAV/AAC para Ogg/Opus,
# os formatos que o WhatsApp entrega (roteiro de gravação).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN grep -viE '^(pytest|pytest-asyncio)([=<>~ ]|$)' /tmp/requirements.txt > /tmp/requirements-prod.txt \
 && pip install -r /tmp/requirements-prod.txt \
 && rm /tmp/requirements*.txt

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin lawchat \
 && mkdir -p /dados/midia \
 && chown -R lawchat:lawchat /dados

COPY --chown=lawchat:lawchat app/ /srv/app/
# O servidor procura o front em <raiz>/painel/dist (app/main.py).
COPY --from=front --chown=lawchat:lawchat /painel/dist/ /srv/painel/dist/

USER lawchat
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/saude' % os.environ.get('PORT', '8000'), timeout=4)" || exit 1

CMD ["sh", "-c", "exec uvicorn app.entrada_painel:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*'"]
