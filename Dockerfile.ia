# App "ia" (Easypanel): webhooks da Helena e da ZapSign, pipeline, fila de ações, follow-ups e laços de fundo.
# Build:  docker build -f Dockerfile.ia -t lawchat-ia .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8000 \
    AGENTESIA_PASTA_MIDIA=/dados/midia

WORKDIR /srv

# ffmpeg: converte vídeo gravado no navegador (WebM) ou do iPhone (MOV) para MP4, e áudio WAV/AAC para Ogg/Opus,
# os formatos que o WhatsApp entrega (roteiro de gravação).
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

# Dependências de produção (pytest fica de fora da imagem).
COPY requirements.txt /tmp/requirements.txt
RUN grep -viE '^(pytest|pytest-asyncio)([=<>~ ]|$)' /tmp/requirements.txt > /tmp/requirements-prod.txt \
 && pip install -r /tmp/requirements-prod.txt \
 && rm /tmp/requirements*.txt

# Usuário sem privilégios; /dados/midia é onde montar o volume da mídia (compartilhado com o painel).
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin lawchat \
 && mkdir -p /dados/midia \
 && chown -R lawchat:lawchat /dados

COPY --chown=lawchat:lawchat app/ /srv/app/

USER lawchat
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/saude' % os.environ.get('PORT', '8000'), timeout=4)" || exit 1

# --timeout-graceful-shutdown: dá tempo aos turnos em andamento (AGENTESIA_DESLIGAR_TETO_S, padrão 30 s).
CMD ["sh", "-c", "exec uvicorn app.entrada_ia:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips='*' --timeout-graceful-shutdown 40"]
