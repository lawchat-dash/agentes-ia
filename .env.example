# Copie para .env e preencha. O arquivo .env nunca vai para o git.

# Chave da OpenAI (GPT), o provedor padrão. Sem ela, só o modelo de mentira funciona.
OPENAI_API_KEY=

# Chave da Anthropic: só se algum agente usar modelo claude-...
ANTHROPIC_API_KEY=

# Modelo padrão dos agentes (cada agente pode ter o seu na configuração).
AGENTESIA_MODELO=gpt-4.1

# Banco do Supabase (Project Settings > Database > Connection string, modo "Transaction pooler").
# Sem esta linha, só o Laboratório funciona.
AGENTESIA_BANCO_URL=
# Conexões do pool com o banco (padrão 10), espera máxima por conexão e por consulta, em segundos.
AGENTESIA_BANCO_CONEXOES=10
AGENTESIA_BANCO_TIMEOUT_S=10
AGENTESIA_BANCO_COMANDO_S=15

# Tempo máximo de cada chamada à IA (padrão 60 s, 1 nova tentativa do SDK) e do turno inteiro (padrão 180 s).
AGENTESIA_IA_TIMEOUT_S=60
AGENTESIA_TETO_TURNO_S=180
# No desligamento, quanto esperar os turnos em andamento terminarem (padrão 30 s).
AGENTESIA_DESLIGAR_TETO_S=30

# Segredo MESTRE dos webhooks: nunca vai numa URL. Dele saem os segredos de cada escritório
# (/webhook/helena/{id}?segredo=..., gerado pela ativação no painel).
AGENTESIA_WEBHOOK_SEGREDO=

# 1 = liga a rota global legada /webhook/helena (segredo derivado, não o mestre). Padrão: desligada.
AGENTESIA_WEBHOOK_GLOBAL=

# Senha do Laboratório (obrigatória se o servidor ficar acessível fora do seu computador).
AGENTESIA_LAB_SENHA=

# 1 = não chama a IA (demonstração da página, sem custo).
AGENTESIA_MODELO_FALSO=

# ---- Painel padrão do CRM pela API interna da Helena (impersonate; ver app/gestao/rotas_painel_crm.py) ----
# 1 = liga as rotas /api/admin/escritorios/{id}/painel-crm (padrão: desligadas, respondem 404).
AGENTESIA_PAINEL_CRM_LIGADO=
# URL base da API interna (no n8n: https://api.wts.chat).
AGENTESIA_HELENA_INTERNA_URL=
# E-mail do parceiro que recebe o código (OTP), id do parceiro e id do dispositivo usados no login.
AGENTESIA_HELENA_PARCEIRO_EMAIL=
AGENTESIA_HELENA_PARCEIRO_ID=
AGENTESIA_HELENA_DEVICE_ID=
# Origin/Referer do painel do parceiro (ex.: https://<parceiro>.wts.chat).
AGENTESIA_HELENA_PARCEIRO_ORIGEM=
# E-mail do usuário admin da LawChat dentro de cada conta (vira adminUserIds do painel).
AGENTESIA_HELENA_ADMIN_EMAIL=
# Token de parceiro da Helena (API pública): lista contas, gera o token da conta e lê os dados da empresa.
AGENTESIA_HELENA_TOKEN_PARCEIRO=
# Id da conta da própria LawChat na Helena (a do token de parceiro): aparece marcada em Sincronizar com a Helena.
AGENTESIA_HELENA_CONTA_LAWCHAT=

# ---- Endereços, sessão e mídia (deploy: ver docs/DEPLOY_EASYPANEL.md) ----
# Endereço público do app "ia", com https:// e sem barra no fim. É a base das URLs de webhook (Helena e ZapSign)
# geradas na ativação e, no modo local da mídia, dos links de mídia dos prompts. Vai nos DOIS apps (ia e painel), com o mesmo valor.
AGENTESIA_URL_PUBLICA=
# Segredo que assina o cookie de sessão do painel (texto longo e aleatório). Sem ele, as sessões caem a cada reinício.
AGENTESIA_SEGREDO_SESSAO=
# Onde fica a mídia da biblioteca (áudio, vídeo e imagem dos prompts):
#   local    = disco do servidor, servido em /midia (desenvolvimento e testes). Padrão.
#   supabase = bucket do Supabase Storage (produção no Easypanel: os dois apps não dividem pasta nenhuma).
AGENTESIA_MIDIA_ARMAZENAMENTO=local
# Modo supabase: endereço do projeto (https://<projeto>.supabase.co), chave service_role (Project Settings > API;
# SEGREDO: só no Environment do Easypanel, nunca no repositório) e o bucket (criado com db/exemplos/criar_bucket_midia.sql).
AGENTESIA_SUPABASE_URL=
AGENTESIA_SUPABASE_SERVICE_KEY=
AGENTESIA_MIDIA_BUCKET=agentesia-midia
# Modo local: pasta onde a mídia é gravada e servida em /midia. Vazio = <raiz do projeto>/dados/midia.
AGENTESIA_PASTA_MIDIA=
# URL base da API pública da Helena (padrão https://api.helena.run).
AGENTESIA_HELENA_URL=

# ---- Login pela Helena (link /entrar/helena) ----
# Se preenchido, o link de entrada precisa vir assinado (sig = HMAC-SHA256 deste segredo), válido por 5 min.
AGENTESIA_HELENA_HANDOFF_SEGREDO=
# Id da conta Helena da própria LawChat: quem entra por ela vira equipe LawChat no painel.
AGENTESIA_HELENA_CONTA_LAWCHAT=

# ---- Central de avisos da LawChat (erros graves viram WhatsApp para a equipe) ----
# Token da conta Helena da LawChat, número que envia e números que recebem (separados por vírgula).
AGENTESIA_HELENA_TOKEN_LAWCHAT=
AGENTESIA_ALERTA_LAWCHAT_DE=
AGENTESIA_ALERTA_LAWCHAT_PARA=

# ---- Ritmo do atendimento (padrões entre parênteses) ----
# Espera antes de responder, em segundos: mínima (15), máxima (90) e padrão (40); tempo de "digitação" por letra (0.5).
AGENTESIA_ESPERA_MINIMA=15
AGENTESIA_ESPERA_MAXIMA=90
AGENTESIA_ESPERA_PADRAO=40
AGENTESIA_SEGUNDOS_POR_LETRA=0.5
# Quantas vezes um turno com erro é refeito (2).
AGENTESIA_MAX_REPROCESSOS=2
# Modelo dos follow-ups (padrão gpt-4.1-mini) e do auditor da resposta (vazio = padrão do código).
AGENTESIA_MODELO_FOLLOWUP=gpt-4.1-mini
AGENTESIA_MODELO_AUDITOR=

# ---- Só para teste local (NUNCA em produção) ----
# 1 = modo de laboratório: permite usar o token global abaixo no lugar do token de cada escritório.
AGENTESIA_MODO_LAB=
AGENTESIA_HELENA_TOKEN=
# URL de uma ZapSign de mentira (db/testes/helena_falsa.py).
AGENTESIA_ZAPSIGN_URL_TESTE=

# Cobrança da IA em R$ (docs/COBRANCA_TOKENS.md). Débito em lote a cada N segundos; gateway da recarga: manual | asaas.
AGENTESIA_COBRANCA_INTERVALO_S=60
AGENTESIA_GATEWAY_RECARGA=manual
# Token do webhook do Asaas (o mesmo cadastrado no painel do Asaas). Vazio = webhook desligado (401).
AGENTESIA_ASAAS_WEBHOOK_TOKEN=
